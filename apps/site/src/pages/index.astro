---
import Base from "../layouts/Base.astro";

const reasons = [
  {
    title: "Gampang untuk semua umur",
    text: "Tombol besar, tiga pilihan ukuran teks, dan bahasa sehari-hari. Tidak ada istilah asing.",
  },
  {
    title: "Tetap jualan saat internet mati",
    text: "Transaksi disimpan di perangkat dan dikirim otomatis saat internet kembali. Selalu terlihat berapa yang menunggu dikirim.",
  },
  {
    title: "Stok cocok dengan barang di rak",
    text: "Stok opname dari HP, selisih tercatat beserta alasannya, dan semua perubahan stok bisa dilacak.",
  },
];
---

<Base title="Aplikasi kasir untuk semua usaha">
  <section class="hero">
    <h1>Kasir yang gampang dipakai, dari warung sampai resto.</h1>
    <p>Jalan di HP Android, tablet, dan mesin kasir. Struk lewat WhatsApp, QRIS, stok, dan laporan dalam satu aplikasi.</p>
    <div class="actions">
      <a class="button button-primary" href="/harga">Lihat paket, mulai gratis</a>
    </div>
  </section>

  <section class="reasons" aria-label="Kenapa memilih kami">
    {
      reasons.map((r) => (
        <article>
          <h2>{r.title}</h2>
          <p>{r.text}</p>
        </article>
      ))
    }
  </section>
</Base>

<style>
  .hero {
    padding: var(--space-10) 0;
    max-width: 760px;
  }
  .hero h1 {
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.15;
    margin: 0 0 var(--space-4);
  }
  .hero p {
    font-size: 20px;
    color: var(--color-ink-muted);
  }
  .actions {
    margin-top: var(--space-6);
  }
  .reasons {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .reasons article {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }
  .reasons h2 {
    font-size: 20px;
    margin: 0 0 var(--space-2);
  }
  .reasons p {
    margin: 0;
    color: var(--color-ink-muted);
  }
</style>
