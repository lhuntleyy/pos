# Salin jadi .env (sudah di-ignore git). Nilai ini cocok dengan infra/dev/docker-compose.yml.
APP_ENV=development
HTTP_ADDR=:8080

# Role aplikasi tanpa BYPASSRLS, supaya RLS benar-benar aktif.
DATABASE_URL=postgres://pos_app:pos_app_dev@localhost:5432/pos?sslmode=disable
# Role pemilik tabel, hanya untuk `api migrate`.
MIGRATION_DATABASE_URL=postgres://postgres:postgres_dev@localhost:5432/pos?sslmode=disable

REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4321
