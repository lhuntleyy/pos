# Salin jadi .env (sudah di-ignore git).
PORT=8090
# fake = tidak mengirim apa pun (development). baileys = WhatsApp sungguhan.
WA_PROVIDER=fake
# Minimal 24 karakter, sama dengan WA_GATEWAY_SECRET di API.
GATEWAY_SECRET=ganti-dengan-rahasia-panjang-acak
# 32 byte base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
SESSION_DIR=.sessions
DAILY_LIMIT=300
MIN_DELAY_MS=1500
MAX_DELAY_MS=4000
LOG_LEVEL=info
