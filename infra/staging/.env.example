# Salin jadi .env di server staging. JANGAN commit .env.
API_DOMAIN=api.staging.contoh.id
APP_DOMAIN=app.staging.contoh.id
SITE_DOMAIN=staging.contoh.id

# Ganti OWNER dengan nama org/akun GitHub
API_IMAGE=ghcr.io/OWNER/pos-api:main
WA_IMAGE=ghcr.io/OWNER/pos-wa-gateway:main

# Buat password acak: openssl rand -base64 32
POSTGRES_PASSWORD=
POS_APP_DB_PASSWORD=
WA_GATEWAY_SECRET=
# 32 byte base64: openssl rand -base64 32
WA_SESSION_ENCRYPTION_KEY=
